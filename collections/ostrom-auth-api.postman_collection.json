          "name": "Obtain OAuth2 Access Token",
          "request": {
            "name": "Obtain OAuth2 Access Token",
            "description": {
              "content": "Allowed role: `USER` or `PARTNER`",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "oauth2",
                "token"
              ],
              "host": [
                "auth",
                "sandbox",
                "ostrom-api",
                "io"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) The Oauth grant type (e.g. client_credentials)"
                }
              ]
            }
          },
          "response": [
            {
              "id": "2da4635b-a3ac-4470-98a5-df69778de01d",
