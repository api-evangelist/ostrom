      "item": [
        {
          "id": "84ed56aa-cacd-482a-8cb5-0ff6316d7c5b",
          "name": "Retrieve day-ahead spot price information",
          "request": {
            "name": "Retrieve day-ahead spot price information",
            "description": {
              "content": "Allowed role: `USER` or `PARTNER`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "spot-prices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "(Required) start date ISO format on UTC timezone. e.g. 2023-11-01T00:00:00.000Z"
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "(Required) end date ISO format on UTC timezone. e.g. 2023-11-02T00:00:00.000Z"
                },
                {
                  "disabled": false,
                  "key": "resolution",
                  "value": "<string>",
                  "description": "(Required) The unit of time the data will be aggregated"
                },
                {
                  "disabled": false,
                  "key": "zip",
                  "value": "<string>",
                  "description": "Zip code used to fetch Ostrom base price, gridFees, tax and levies. If not provided the respective values are returned as zero."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "https://auth.sandbox.ostrom-api.io/oauth2/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
